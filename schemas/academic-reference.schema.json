{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AIPE Academy academic reference catalogue v0.2",
  "description": "references/mit-ocw-catalogue.json. Curated fields are AIPE Academy's mapping; the `verified` block is written only by scripts/verify_academic_sources.py from the official course page and its data.json.",
  "type": "object",
  "required": ["schema_version", "project", "purpose", "relationship", "license_note", "status_vocabulary", "courses"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "0.2.0"},
    "project": {"type": "string"},
    "purpose": {"type": "string"},
    "relationship": {"type": "string"},
    "license_note": {"type": "string"},
    "status_vocabulary": {"type": "object", "additionalProperties": {"type": "string"}},
    "courses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "institution", "platform", "course_number", "title", "term", "url", "primary_domain", "academic_level", "priority", "topics", "mapped_modules", "resource_status", "verified_on"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
          "institution": {"type": "string", "minLength": 1},
          "platform": {"type": "string", "minLength": 1},
          "course_number": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "term": {"type": "string", "minLength": 1},
          "url": {"type": "string", "pattern": "^https://ocw\\.mit\\.edu/courses/[a-z0-9-]+/$"},
          "primary_domain": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
          "secondary_domains": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"}},
          "reference_area": {"type": "string"},
          "academic_level": {"enum": ["undergraduate", "graduate", "mixed"]},
          "priority": {"enum": ["core", "foundation", "supplementary", "historical"]},
          "topics": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"}},
          "mapped_modules": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["module", "coverage"],
              "additionalProperties": false,
              "properties": {
                "module": {"type": "string", "pattern": "^[a-z]{1,3}\\.[a-z][a-z0-9-]*$"},
                "coverage": {"enum": ["core", "partial", "introductory", "background"]},
                "mit_topics": {"type": "array", "items": {"type": "string"}},
                "evidence_url": {"type": "string", "pattern": "^https://"},
                "rationale": {"type": "string"}
              }
            }
          },
          "mapped_lessons": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"}},
          "key_resources": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["label", "url"],
              "additionalProperties": false,
              "properties": {
                "label": {"type": "string", "minLength": 1},
                "url": {"type": "string", "pattern": "^https://ocw\\.mit\\.edu/"},
                "summary": {"type": "string"}
              }
            }
          },
          "coverage_notes": {"type": "string"},
          "concepts_missing_in_aipe": {"type": "array", "items": {"type": "string"}},
          "gaps": {"type": "array", "items": {"type": "string"}},
          "access_limitations": {"type": "array", "items": {"type": "string"}},
          "verified_on": {"type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
          "resource_status": {"enum": ["verified", "verified-with-differences", "page-only", "unavailable", "pending-review"]},
          "verified": {
            "type": "object",
            "required": ["verified_on", "homepage_status", "canonical_url", "official_title", "course_numbers", "term", "level", "instructors", "learning_resource_types", "subpages", "syllabus_status", "expectation_mismatches"],
            "additionalProperties": false,
            "properties": {
              "verified_on": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
              "homepage_status": {"type": ["integer", "null"]},
              "canonical_url": {"type": "string", "pattern": "^https://ocw\\.mit\\.edu/"},
              "official_title": {"type": ["string", "null"]},
              "course_numbers": {"type": "array", "items": {"type": "string"}},
              "term": {"type": ["string", "null"]},
              "level": {"type": ["array", "null"], "items": {"type": "string"}},
              "instructors": {"type": ["array", "null"], "items": {"type": "string"}},
              "learning_resource_types": {"type": ["array", "null"], "items": {"type": "string"}},
              "mit_topics": {},
              "subpages": {"type": "object", "additionalProperties": {"type": "array", "items": {"type": "string"}}},
              "syllabus_status": {"type": ["integer", "null"]},
              "expectation_mismatches": {"type": "array", "items": {"type": "string"}}
            }
          }
        }
      }
    }
  }
}

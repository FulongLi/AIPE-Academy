{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AIPE Academy lesson metadata v0.1",
  "type": "object",
  "required": [
    "title",
    "slug",
    "domain",
    "track",
    "level",
    "type",
    "status",
    "source",
    "language",
    "prerequisites",
    "learning_objectives",
    "next",
    "references",
    "estimated_time",
    "tools"
  ],
  "additionalProperties": false,
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "slug": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "domain": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "track": {
      "type": "string",
      "minLength": 1
    },
    "level": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "outline",
        "draft",
        "available"
      ]
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "type": "string",
      "minLength": 1
    },
    "prerequisites": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "learning_objectives": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "next": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "references": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "estimated_time": {
      "type": "integer",
      "minimum": 1
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "licence_class",
          "optional"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "licence_class": {
            "enum": [
              "open_source",
              "free_proprietary",
              "commercial"
            ]
          },
          "optional": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
